# Google Calendar
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Microsoft/Outlook Calendar
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

PORT=3001
# Where OAuth providers redirect back to. Dev: http://127.0.0.1:5173  Panel: your Tailscale URL
FRONTEND_URL=https://sentinel.<tailnet>.ts.net

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Govee Lights
GOVEE_API_KEY=your_govee_api_key

# SmartThings OAuth
SMARTTHINGS_CLIENT_ID=your_smartthings_client_id
SMARTTHINGS_CLIENT_SECRET=your_smartthings_client_secret
SMARTTHINGS_TOKEN=your_smartthings_pat

# Groq LLM (free) - get key at console.groq.com
GROQ_API_KEY=your_groq_api_key

# ElevenLabs TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id

# Philips Hue Bridge
HUE_BRIDGE_IP=your_hue_bridge_ip
HUE_USERNAME=your_hue_api_username
# Optional: where server-side OAuth logins are saved (default backend/data/tokens.json)
# TOKEN_STORE_PATH=/var/lib/sentinel/tokens.json
# Optional: Spotify PKCE client id for server-side refresh (defaults to the app's public id)
# SPOTIFY_CLIENT_ID=
# Optional: where registered lock-screen faces are saved (default backend/data/faces.json)
# FACES_STORE_PATH=
# Game Day (server-side). Auto-trigger when a followed team's game goes live.
# GAMEDAY_AUTO=false            # turn the automatic watcher off
# GAMEDAY_INTERVAL_MS=120000    # how often to check ESPN (default 2 min)
# HUE_GAMEDAY_LIGHTS=5,4        # Hue light ids: primary, secondary
# GAMEDAY_GOVEE_LIGHTS=neon,!outdoor   # Govee lights Game Day colors, by name ("!" excludes; "*" = all)
# GAMEDAY_TVS=The Frame               # TVs Game Day wakes, by name ("*" = all)
# Frame TV app per game, picked from the networks ESPN lists (see lib/gameDay.js).
# Default map: ESPN+=ESPN, Peacock/NBC=Peacock, HBO Max/TNT/truTV/TBS=HBO Max, everything else=fubo
# GAMEDAY_TV_NETWORK_APPS=ESPN+=ESPN,Peacock=Peacock,*=fubo   # replace the map
# GAMEDAY_TV_APP_BARCELONA=ESPN # per-team override: lions, michigan_football, michigan_basketball, pistons, barcelona
# GAMEDAY_TV_APP=fubo           # when ESPN doesn't list a network
# GAMEDAY_TV_MUTE=false         # Game Day mutes the TV by default

# Sentinel AI (Groq). Groq retires models; change this when they do.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=low     # empty for non-reasoning models

# Pi mic ("Alfred, ..."; see docs/voice-on-pi.md). scripts/voice-install.sh generates
# VOICE_TOKEN on the Pi; the rest are optional.
# VOICE_TOKEN=
# VOICE_WAKE_MODEL=alfred       # voice/models/<name>.onnx, a built-in (hey_jarvis), or a list
# VOICE_THRESHOLD=0.5          # wake sensitivity: higher = fewer false wakes
# VOICE_MIC=                   # input device name fragment (default: first USB mic)
# VOICE_SPEAKER=auto           # auto (first USB speaker) | none | plughw:2,0
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Rules: sunrise/sunset triggers need your home coordinates (decimal degrees)
# HOME_LAT=
# HOME_LON=
# RULES_AUTO=false              # turn the rule scheduler off

# Frame TVs on the local network (no SmartThings needed). Name@IP, comma-separated.
# Reserve these IPs in your router. First use: press Pair in the Frame TV widget, Allow on the TV.
# FRAME_TVS=Office@10.0.0.35

# Push notifications via ntfy (free). Install the ntfy app and subscribe to this topic.
# On ntfy.sh the topic name is the password: keep it long and random.
# NTFY_TOPIC=sentinel-<random>
# NTFY_URL=https://ntfy.sh            # or your self-hosted server
# NTFY_TOKEN=                         # only for a self-hosted server with auth
# NTFY_MUTE=presence                  # categories to silence: system,gameday,print,presence,rules

# Presence: Tailscale machine names of phones (see /api/presence/peers). Name@machine
# PRESENCE_DEVICES=Josh@josh-iphone
# PRESENCE_LEAVE_MIN=10               # minutes without a home sighting before "left"
# TAILSCALE_BIN=                      # auto-detected (Mac app or `tailscale` on PATH)

# Bambu Lab printer, local network. Printer screen: Settings > Network (IP, access code),
# Settings > Device (serial). Works in normal cloud mode; Bambu Handy keeps working.
# BAMBU_HOST=10.0.0.x
# BAMBU_SERIAL=
# BAMBU_ACCESS_CODE=
# BAMBU_NAME=Bambu P2S
