# Google Calendar
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Microsoft/Outlook Calendar
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

PORT=3001
# Where OAuth providers redirect back to. Dev: http://127.0.0.1:5173  Panel: your Tailscale URL
FRONTEND_URL=https://sentinel.<tailnet>.ts.net

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Govee Lights
GOVEE_API_KEY=your_govee_api_key

# SmartThings OAuth
SMARTTHINGS_CLIENT_ID=your_smartthings_client_id
SMARTTHINGS_CLIENT_SECRET=your_smartthings_client_secret
SMARTTHINGS_TOKEN=your_smartthings_pat

# Groq LLM (free) - get key at console.groq.com
GROQ_API_KEY=your_groq_api_key

# ElevenLabs TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id

# Tesla API
TESLA_CLIENT_ID=your_tesla_client_id
TESLA_CLIENT_SECRET=your_tesla_client_secret

# Philips Hue Bridge
HUE_BRIDGE_IP=your_hue_bridge_ip
HUE_USERNAME=your_hue_api_username
# Must match the redirect registered in the Tesla developer portal (localhost only for http)
TESLA_REDIRECT_URI=http://localhost:5173

# Optional: where server-side OAuth logins are saved (default backend/data/tokens.json)
# TOKEN_STORE_PATH=/var/lib/sentinel/tokens.json
# Optional: Spotify PKCE client id for server-side refresh (defaults to the app's public id)
# SPOTIFY_CLIENT_ID=
# Optional: where registered lock-screen faces are saved (default backend/data/faces.json)
# FACES_STORE_PATH=
# Optional: Tesla Fleet API region (default North America)
# TESLA_FLEET_API_BASE=https://fleet-api.prd.na.vn.cloud.tesla.com
